# Database Configuration
# For local development, you can use a local PostgreSQL instance or a cloud service like Neon
# Example: postgresql://user:password@localhost:5432/portfolio
# Example for Neon: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Server Configuration
PORT=5000
NODE_ENV=development

